<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Admin Settings</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
    <link rel="stylesheet" href="/plugins/fontawesome-free/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="/dist/css/adminlte.min.css">
    <link rel="stylesheet" href="/css/admin.css">
    <link href="//cdn.jsdelivr.net/npm/@sweetalert2/theme-dark@4/dark.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <style>
        .form-group {
            margin-top: 20px;
            padding: 20px;
            border-radius: 5px;
            box-shadow: 0 0 5px #2ecc71;
        }
        
        .form-group button {
            margin-top: 30px;
        }
    </style>
</head>

<body class="hold-transition sidebar-mini">
    <div class="wrapper">
        <%- include('nav') %>
            <div class="content-wrapper">
                <section class="content-header">
                    <div class="container-fluid">
                        <div class="row mb-2">
                            <div class="col-sm-6">
                                <h1>Admin Settings & Controls</h1>
                            </div>
                        </div>
                    </div>
                </section>

                <div class="container-fluid">
                    <div class="row">
                        <div class="col-md-12">
                            <div style="padding: 10px 20px;margin-bottom: 200px;">
                                <div class="form-group">
                                    <div class="text-center">
                                        <label for="quantity">Increase / Decrease Member Balance (INR ₹)</label>
                                    </div>
                                    <input type="text" class="form-control" oninput="value=value.replace(/\D/g,'')" id="buff-id" placeholder="Enter Account Phone Number"><br>
                                    <select class="form-select mb-4" id="buff-acc" aria-label="Default select example">
                                        <option selected value="">--------------- Select Action ---------------</option>
                                        <option value="1">Increase (+)</option>
                                        <option value="2">Decrease (-)</option>
                                    </select>

                                    <input type="text" class="form-control" oninput="value=value.replace(/\D/g,'')" id="buff-money" placeholder="Enter Amount in ₹">
                                    <button type="submit" class="btn btn-primary" id="buff-username" style="width: 100%;">Submit</button>
                                </div>

                                <div class="form-group">
                                    <div class="text-center">
                                        <label for="quantity">Recharge Payment Settings (India UPI / Bank)</label>
                                    </div>
                                    <label for="quantity" style="color: #3498db;">BANK TRANSFER / IFSC</label>
                                    <input type="text" class="form-control" placeholder="Bank Name (e.g. HDFC / SBI / ICICI)" id="edit-banking-name_bank" value=""><br>
                                    <input type="text" class="form-control" placeholder="Account Holder Name" id="edit-banking-name" value=""><br>
                                    <input type="text" class="form-control" placeholder="Account Number / IFSC Code" id="edit-banking-info" value=""><br>
                                    <button type="submit" class="btn btn-primary edit-banking" style="width: 100%;margin-bottom: 20px;">Save Bank Details</button>
                                    <!---------------------------------------------------------------->
                                    <label for="quantity" style="color: #a50064;">UPI / PAYTM / PHONEPE</label>
                                    <input type="text" class="form-control" placeholder="Payment Method (e.g. UPI / Paytm)" id="edit-momo-name_bank" value=""><br>
                                    <input type="text" class="form-control" placeholder="Name on UPI / Paytm" id="edit-momo-name" value=""><br>
                                    <input type="text" class="form-control" placeholder="UPI ID / PhonePe Number" id="edit-momo-info" value=""><br>
                                    <button type="submit" class="btn btn-primary edit-momo" style="width: 100%;">Save UPI Details</button>
                                </div>

                                <div class="form-group">
                                    <div class="text-center">
                                        <label for="edit-win-rate-val" style="color: #27ae60; font-weight: bold; font-size: 18px;">Automatic Winning Rate Control (%)</label>
                                    </div>
                                    <label style="color: #2c3e50;">Adjust Target User Win Rate Percentage (0% to 100%)</label>
                                    <p class="text-muted" style="font-size: 13px;">
                                        * Note: Lower win rate (e.g., 20% - 40%) maximizes house profit by choosing optimal numbers for user bets when in Auto Mode (-1).
                                    </p>
                                    <div class="input-group mb-3">
                                        <input type="number" class="form-control" id="edit-win-rate-val" min="0" max="100" placeholder="Target Win Rate %" value="80">
                                        <span class="input-group-text">%</span>
                                    </div>
                                    <button type="button" class="btn btn-success edit-win-rate-btn" style="width: 100%;">Save Win Rate Setting</button>
                                </div>

                                <div class="form-group">
                                    <div class="text-center">
                                        <label for="telegram">Support & Telegram Links</label>
                                    </div>
                                    <label for="telegram" style="color: #3498db;">Telegram Group Link</label>
                                    <input type="text" class="form-control" id="telegram" placeholder="https://t.me/your_channel" value=""><br>
                                    <label for="cskh" style="color: #3498db;">Customer Support Link</label>
                                    <input type="text" class="form-control" id="cskh" placeholder="https://t.me/your_support" value=""><br>
                                    <label for="myapp_web" style="color: #3498db;">App Download Link</label>
                                    <input type="text" class="form-control" id="myapp_web" placeholder="App Download URL" value=""><br>
                                    <button type="submit" class="btn btn-primary telegram" style="width: 100%;">Save Links</button>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
    </div>
    <script src="/plugins/jquery/jquery.min.js"></script>
    <script src="/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/dist/js/adminlte.min.js"></script>
    <script src="/js/admin/admin.js"></script>
    <script src="//cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.js"></script>
    <script>
        $.ajax({
            type: "POST",
            url: "/admin/manager/settings/get",
            data: "data",
            dataType: "json",
            success: function (response) {
                let bank = response.datas[0];
                let momo = response.datas[1];
                $('#edit-momo-name_bank').val(momo.name_bank);
                $('#edit-momo-name').val(momo.name_user);
                $('#edit-momo-info').val(momo.stk);

                $('#edit-banking-name_bank').val(bank.name_bank);
                $('#edit-banking-name').val(bank.name_user);
                $('#edit-banking-info').val(bank.stk);

                $('#telegram').val(response.settings[0].telegram);
                $('#cskh').val(response.settings[0].cskh);
                $('#myapp_web').val(response.settings[0].app);
                if (response.settings && response.settings[0] && response.settings[0].win_rate !== undefined) {
                    $('#edit-win-rate-val').val(response.settings[0].win_rate);
                }
            }
        });
    </script>
    <script>
        $('.edit-win-rate-btn').click(function (e) {
            e.preventDefault();
            let val = $('#edit-win-rate-val').val();
            $.ajax({
                type: "POST",
                url: "/admin/manager/settings/change",
                data: {
                    type: 'change-win_rate',
                    value: val,
                    bs: 'win_rate'
                },
                dataType: "json",
                success: function (response) {
                    if (response.status == true) {
                        Swal.fire('Saved!', 'Automatic Win Rate updated to ' + val + '%', 'success');
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Failed',
                            text: 'Failed to update win rate',
                        });
                    }
                }
            });
        });
    <script>
        function sendRequest(params1, params2, typer) {
            $.ajax({
                type: "POST",
                url: "/manage/admin/settings",
                data: {
                    params1: params1,
                    params2: params2,
                    typer: typer,
                },
                dataType: "json",
                success: function(response) {
                    if (response.message == 1) {
                        Swal.fire(
                            'Good job!',
                            'Successfully updated!',
                            'success'
                        )
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Failed',
                            text: 'An error occurred',
                        })
                    }
                }
            });
        }
        $('.edit-banking').click(function (e) { 
            e.preventDefault();
            let name_bank = $('#edit-banking-name_bank').val();
            let name = $('#edit-banking-name').val();
            let info = $('#edit-banking-info').val();
            sendRequest(name_bank, name, info, 'bank');
        });
        $('.edit-momo').click(function (e) { 
            e.preventDefault();
            let name_bank = $('#edit-momo-name_bank').val();
            let name = $('#edit-momo-name').val();
            let info = $('#edit-momo-info').val();
            sendRequest(name_bank, name, info, 'momo');
        });
        $('.telegram').click(function (e) { 
            e.preventDefault();
            let telegram = $('#telegram').val();
            let cskh = $('#cskh').val();
            let myapp_web = $('#myapp_web').val();
            $.ajax({
                type: "POST",
                url: "/admin/manager/settings/cskh",
                data: {
                    telegram: telegram,
                    cskh: cskh,
                    myapp_web: myapp_web,
                },
                dataType: "json",
                success: function (response) {
                    if (response.status == true) {
                        Swal.fire(
                            'Good job!',
                            'Successfully updated!',
                            'success'
                        )
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Failed',
                            text: 'An error occurred',
                        })
                    }
                }
            });
        });
        $('#buff-username').click(function (e) { 
            e.preventDefault();
            let phone = $('#buff-id').val().trim();
            let select = $('#buff-acc').val().trim();
            let money = $('#buff-money').val().trim();
            if (!phone || !select || !money) {
                alert("Please fill in all required fields");
                return;
            }
            $.ajax({
                type: "POST",
                url: "/admin/manager/settings/buff",
                data: {
                    phone: phone,
                    select: select,
                    money: money,
                },
                dataType: "json",
                success: function (response) {
                    if (response.status == true) {
                        Swal.fire(
                            'Good job!',
                            response.message,
                            'success'
                        )
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Failed',
                            text: response.message,
                        })
                    }
                }
            });
        });
    </script>
</body>

</html>